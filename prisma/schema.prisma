generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  name             String?
  role             String    @default("CUSTOMER")
  phone            String?
  altPhone         String?
  address          String?
  city             String?
  state            String?
  zip              String?
  landmark         String?
  isVerified       Boolean   @default(false)
  otp              String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  orders           Order[]
  reviews          Review[]
}

model Admin {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String?
  role      String     @default("ADMIN")
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  slug       String   @unique
  image      String?  @db.LongText
  showOnHome Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Expense {
  id           Int      @id @default(autoincrement())
  amount       Float
  investorName String
  reason       String
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  text      String
  rating    Int      @default(5)
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId], map: "Review_productId_fkey")
  @@index([userId], map: "Review_userId_fkey")
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  description       String
  price             Float
  stock             Int         @default(50)
  showStockCount    Boolean     @default(true)
  images            String      @db.LongText
  category          String
  occasions         String?
  rating            Float       @default(0)
  isBestSeller      Boolean     @default(false)
  originalPrice     Float?
  fakeRatingCount   Int         @default(0)
  isInCarousel      Boolean     @default(false)
  isInHero          Boolean     @default(false)
  isNewArrival      Boolean     @default(false)
  size              String?
  variantGroupId    String?
  isMainVariant     Boolean     @default(false)
  similarProductIds String?
  gallery           String?     @db.LongText
  createdAt         DateTime    @default(now())
  orderItems        OrderItem[]
  reviews           Review[]
}

model Order {
  id                   Int         @id @default(autoincrement())
  userId               Int
  status               String      @default("PENDING")
  total                Float
  paymentMethod        String      @default("COD")
  shippingMethod       String      @default("STANDARD")
  shippingName         String?
  shippingAddress      String?
  shippingCity         String?
  shippingState        String?
  shippingPincode      String?
  shippingPhone        String?
  shippingEmail        String?
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  trackingUrl          String?
  courierName          String?
  couponCode           String?
  discountAmount       Float?
  createdAt            DateTime    @default(now())
  trackingId           String?     @unique
  user                 User        @relation(fields: [userId], references: [id])
  items                OrderItem[]

  @@index([userId], map: "Order_userId_fkey")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String
  adminId   Int
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId], map: "AuditLog_adminId_fkey")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String   @unique
  otp        String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model OfferBanner {
  id             Int      @id @default(autoincrement())
  title          String?
  imageUrl       String   @db.LongText
  mobileImageUrl String?  @db.LongText
  link           String?
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String
  discountValue Float
  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Occasion {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
